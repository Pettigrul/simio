# SIMIO — exemplo de configuração. Copie para `.env` (NUNCA versionado) e preencha localmente.
# Nenhum valor real deve ser registrado neste arquivo.

# ---- Vertex AI / Gemini (autenticação via ADC: gcloud auth application-default login
#      ou conta de serviço autorizada pela organização; SIMIO não lê credenciais diretamente)
SIMIO_GCP_PROJECT=
SIMIO_GCP_LOCATION=global
SIMIO_ANALYSIS_MODEL=
# Opcionais (padrão = modelo de análise)
SIMIO_REVIEW_MODEL=
SIMIO_DISCOVERY_MODEL=
SIMIO_LLM_MAX_OUTPUT_TOKENS=4096
SIMIO_LLM_TEMPERATURE=0.2
SIMIO_LLM_TIMEOUT_S=120

# ---- Orçamentos por campanha
SIMIO_MAX_LLM_REQUESTS=300
SIMIO_MAX_LLM_TOKENS=2000000
SIMIO_MAX_SEARCH_QUERIES=40

# ---- Concorrência e retentativas
SIMIO_WORKERS=3
SIMIO_MAX_ATTEMPTS=3
SIMIO_MAX_RECOLLECTS=1

# ---- Conectores opcionais de descoberta (deixe vazio se não contratados)
SIMIO_BRAVE_API_KEY=
SIMIO_SERPER_API_KEY=
SIMIO_URLSCAN_API_KEY=

# ---- Navegador / rede
# Proxy corporativo para o navegador (ex.: http://proxy.interno:8080). As APIs (httpx/google-genai)
# usam HTTPS_PROXY / NO_PROXY / SSL_CERT_FILE do ambiente.
SIMIO_BROWSER_PROXY=
SIMIO_NAV_TIMEOUT_MS=30000
SIMIO_PAGE_BUDGET_S=90
SIMIO_IGNORE_HTTPS_ERRORS=false
# SIMIO_ALLOWED_PORTS=80,443,8080,8443
# SOMENTE PARA TESTES LOCAIS — nunca usar em produção:
# SIMIO_UNSAFE_ALLOW_HOSTS=127.0.0.1

# ---- Dados locais (permanecem na máquina de execução)
SIMIO_OUTPUT_DIR=output
# CSV com a relação autorizada de correspondentes (colunas: cnpj;nome;...)
SIMIO_COBAN_REGISTRY_PATH=
# TOML com requisitos contratuais/internos (ver docs/methodology.md)
SIMIO_CONTRACT_REQUIREMENTS_PATH=

SIMIO_LOG_LEVEL=INFO
