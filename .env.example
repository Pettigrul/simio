# Copie para .env (que nunca vai para o git) e preencha na máquina. Nada de valor real aqui.

# Vertex AI / Gemini. Autenticação por ADC (gcloud auth application-default login) ou pela
# conta de serviço da organização; o SIMIO não lê credenciais por conta própria.
SIMIO_PROJETO_GCP=
SIMIO_LOCAL_GCP=global
SIMIO_MODELO_ANALISE=
# Opcionais; vazio = mesmo modelo da análise
SIMIO_MODELO_REVISAO=
SIMIO_MODELO_DESCOBERTA=
SIMIO_LLM_MAX_TOKENS_SAIDA=4096
SIMIO_LLM_TEMPERATURA=0.2
SIMIO_LLM_TIMEOUT_S=120

# Limites por campanha
SIMIO_MAX_REQUISICOES_LLM=300
SIMIO_MAX_TOKENS_LLM=2000000
SIMIO_MAX_CONSULTAS_BUSCA=40

# Paralelismo e novas tentativas
SIMIO_PARALELISMO=3
SIMIO_MAX_TENTATIVAS=3
SIMIO_MAX_RECOLETAS=1

# Conectores de busca opcionais (vazio = não usa)
SIMIO_CHAVE_API_BRAVE=
SIMIO_CHAVE_API_SERPER=
# Páginas de 10 resultados por dork no Serper (1 crédito cada)
SIMIO_PAGINAS_SERPER=1
SIMIO_CHAVE_API_URLSCAN=

# Navegador e rede
# Proxy do navegador (ex.: http://proxy.interno:8080). As APIs usam HTTPS_PROXY, NO_PROXY e
# SSL_CERT_FILE do ambiente.
SIMIO_PROXY_NAVEGADOR=
SIMIO_TIMEOUT_NAVEGACAO_MS=30000
SIMIO_ORCAMENTO_PAGINA_S=90
SIMIO_IGNORAR_ERROS_HTTPS=false
# Deixe true; false só onde o sandbox do Chromium não sobe (risco em docs/security.md)
SIMIO_SANDBOX_NAVEGADOR=true
# Manda ao proxy o IP já validado (contra DNS rebinding). false só se o proxy filtrar por hostname.
SIMIO_PROXY_NAVEGADOR_FIXAR_IP=true
# SIMIO_PORTAS_PERMITIDAS=80,443,8080,8443
# Só para teste local, nunca em produção:
# SIMIO_HOSTS_LIBERADOS_INSEGURO=127.0.0.1

# Dados locais (não saem da máquina)
SIMIO_DIR_SAIDA=resultados
# CSV dos correspondentes autorizados (cnpj;nome;...)
SIMIO_CAMINHO_CADASTRO_COBAN=
# true só se o CSV for fonte oficial ou aprovada (habilita COBAN_CONFIRMADO)
SIMIO_CADASTRO_COBAN_OFICIAL=false
SIMIO_DATA_REFERENCIA_CADASTRO_COBAN=
# Busca H9 a partir dos correspondentes cadastrados: N por campanha, mais recentes primeiro, em
# rodízio entre campanhas. 0 desliga. Pessoa física (MEI com CPF) e instituição financeira ficam de fora.
SIMIO_LIMITE_SEMENTES_COBAN=0
SIMIO_LOTE_SEMENTES_COBAN=4
# TOML com requisitos contratuais (ver docs/methodology.md)
SIMIO_CAMINHO_REQUISITOS_CONTRATUAIS=

SIMIO_NIVEL_LOG=INFO
