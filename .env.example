# SIMIO — exemplo de configuração. Copie para `.env` (NUNCA versionado) e preencha localmente.
# Nenhum valor real deve ser registrado neste arquivo.

# ---- Vertex AI / Gemini (autenticação via ADC: gcloud auth application-default login
#      ou conta de serviço autorizada pela organização; SIMIO não lê credenciais diretamente)
SIMIO_PROJETO_GCP=
SIMIO_LOCAL_GCP=global
SIMIO_MODELO_ANALISE=
# Opcionais (padrão = modelo de análise)
SIMIO_MODELO_REVISAO=
SIMIO_MODELO_DESCOBERTA=
SIMIO_LLM_MAX_TOKENS_SAIDA=4096
SIMIO_LLM_TEMPERATURA=0.2
SIMIO_LLM_TIMEOUT_S=120

# ---- Orçamentos por campanha
SIMIO_MAX_REQUISICOES_LLM=300
SIMIO_MAX_TOKENS_LLM=2000000
SIMIO_MAX_CONSULTAS_BUSCA=40

# ---- Concorrência e retentativas
SIMIO_PARALELISMO=3
SIMIO_MAX_TENTATIVAS=3
SIMIO_MAX_RECOLETAS=1

# ---- Conectores opcionais de descoberta (deixe vazio se não contratados)
SIMIO_CHAVE_API_BRAVE=
SIMIO_CHAVE_API_SERPER=
# Páginas de 10 resultados por dork no Serper (1 crédito cada; contas gratuitas aceitam no máximo 10 por página)
SIMIO_PAGINAS_SERPER=1
SIMIO_CHAVE_API_URLSCAN=

# ---- Navegador / rede
# Proxy corporativo para o navegador (ex.: http://proxy.interno:8080). As APIs (httpx/google-genai)
# usam HTTPS_PROXY / NO_PROXY / SSL_CERT_FILE do ambiente.
SIMIO_PROXY_NAVEGADOR=
SIMIO_TIMEOUT_NAVEGACAO_MS=30000
SIMIO_ORCAMENTO_PAGINA_S=90
SIMIO_IGNORAR_ERROS_HTTPS=false
# Sandbox do Chromium (mantenha true; false somente onde o sandbox não inicia — risco documentado)
SIMIO_SANDBOX_NAVEGADOR=true
# Envia ao proxy corporativo o IP já validado (anti DNS rebinding). Use false somente se o proxy
# exigir hostname para filtragem (risco residual documentado em docs/security.md)
SIMIO_PROXY_NAVEGADOR_FIXAR_IP=true
# SIMIO_PORTAS_PERMITIDAS=80,443,8080,8443
# SOMENTE PARA TESTES LOCAIS — nunca usar em produção:
# SIMIO_HOSTS_LIBERADOS_INSEGURO=127.0.0.1

# ---- Dados locais (permanecem na máquina de execução)
SIMIO_DIR_SAIDA=output
# CSV com a relação autorizada de correspondentes (colunas: cnpj;nome;...)
SIMIO_CAMINHO_CADASTRO_COBAN=
# true SOMENTE se o CSV for fonte oficial/aprovada (habilita CONFIRMED_COBAN); data de referência
SIMIO_CADASTRO_COBAN_OFICIAL=false
SIMIO_DATA_REFERENCIA_CADASTRO_COBAN=
# Busca dirigida aos correspondentes cadastrados (hipóteses H9), complementar à varredura aberta.
# Por campanha, pesquisa os N cadastrados mais recentes ainda não pesquisados em campanhas anteriores
# (rodízio). 0 desliga. Nomes de pessoa física (MEI com CPF) e instituições financeiras são ignorados.
SIMIO_LIMITE_SEMENTES_COBAN=0
SIMIO_LOTE_SEMENTES_COBAN=4
# TOML com requisitos contratuais/internos (ver docs/methodology.md)
SIMIO_CAMINHO_REQUISITOS_CONTRATUAIS=

SIMIO_NIVEL_LOG=INFO
