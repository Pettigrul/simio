{% extends "base.html.j2" %}
{% block titulo %}Ameaças · {{ id_campanha }}{% endblock %}
{% block h1 %}Ameaças à marca e aos clientes{% endblock %}
{% block subtitulo %}Campanha {{ id_campanha }} · {{ nome_marca }} · gerado em {{ gerado_em }}{% endblock %}
{% block conteudo %}
  <div class="numeros">
    {% for nv, n in niveis %}<div class="quadro {{ nv|tom }}"><b>{{ n }}</b>{{ nv|rotulo }}</div>{% endfor %}
  </div>
  <div class="linha">{% for cat, n in categorias %}{{ cat }} ({{ n }}){% if not loop.last %} · {% endif %}{% endfor %}</div>
  <div class="nota">O nível vem de fatos verificáveis: campos de senha ou cartão, personificação registrada pelo analisador, domínio com a marca ou parecido, APK fora das lojas, hospedagem gratuita e idade do domínio. Empresas identificadas que usam a própria marca são tema de conformidade e ficam fora desta lista. As URLs estão desarmadas (<code>hxxps</code>, <code>[.]</code>) para ninguém abrir sem querer.</div>

  {% for nv in ["CRÍTICO", "ALTO", "MÉDIO"] %}
  {% set grupo = fichas | selectattr("nivel", "equalto", nv) | list %}
  {% if grupo %}
  <h2>{{ nv|rotulo }} ({{ grupo | length }})</h2>
  {% for c in grupo %}
  <div class="cartao {{ c.nivel|tom }}">
    <div>
      {% if c.captura %}<img class="captura" src="{{ c.captura }}" alt="Captura de {{ c.dominio }}" loading="lazy">{% else %}<div class="sem-captura">sem captura: página fora do ar ou bloqueada; a classificação se apoia no que foi indexado</div>{% endif %}
    </div>
    <div>
      <span class="selo {{ c.nivel|tom }}">{{ c.nivel|rotulo }} · {{ c.pontuacao|num_br(1) }}</span>{% for cat in c.categorias %}<span class="selo categoria">{{ cat }}</span>{% endfor %}
      <div class="url">{{ c.url }}</div>
      <ul class="fatos">{% for fato in c.fatos %}<li>{{ fato }}</li>{% endfor %}</ul>
      <dl class="campos">
        {% if c.sensiveis %}<dt>Dados pedidos</dt><dd>{{ c.sensiveis }}</dd>{% endif %}
        {% if c.intel %}
        {% if c.intel.plataforma %}<dt>Plataforma</dt><dd>{{ c.intel.plataforma }} (o dono só é identificável pela plataforma)</dd>{% endif %}
        {% if c.intel.criado %}<dt>Domínio criado</dt><dd>{{ c.intel.criado }}{% if c.intel.registrador %} · {{ c.intel.registrador }}{% endif %}</dd>{% endif %}
        {% if c.intel.titular and not c.intel.plataforma %}<dt>Titular</dt><dd>{{ c.intel.titular }}</dd>{% endif %}
        <dt>Resolve hoje</dt><dd>{{ c.intel.resolve }}{% if c.intel.hospedagem %} · {{ c.intel.hospedagem }}{% endif %}</dd>
        {% if c.intel.abuso %}<dt>Contatos de abuso</dt><dd>{{ c.intel.abuso }}</dd>{% endif %}
        {% endif %}
        <dt>Análise SIMIO</dt><dd>{% if c.classificacao %}<span class="cor-{{ c.classificacao|tom }}">{{ c.classificacao|rotulo }}</span>{% endif %}{% if c.dossie %} · <a href="{{ c.dossie }}">dossiê</a>{% endif %}</dd>
      </dl>
      {% if c.justificativa %}<details><summary>Justificativa do analisador</summary>{{ c.justificativa }}</details>{% endif %}
    </div>
  </div>
  {% endfor %}
  {% endif %}
  {% endfor %}

  {% set baixos = fichas | selectattr("nivel", "equalto", "BAIXO") | list %}
  {% if baixos %}
  <h2>Monitorar ({{ baixos | length }})</h2>
  <div class="rolagem">
  <table>
    <thead><tr><th>URL</th><th>Por quê</th><th>Domínio criado</th><th>Titular</th></tr></thead>
    <tbody>
    {% for c in baixos %}
    <tr><td class="mono">{{ c.url }}</td><td>{{ c.fatos | join("; ") }}</td><td>{{ c.intel.criado if c.intel else "" }}</td><td>{{ c.intel.titular if c.intel else "" }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  {% if defensivos %}
  <h2>Registros defensivos do próprio grupo ({{ defensivos | length }})</h2>
  <div class="rolagem">
  <table>
    <thead><tr><th>Domínio</th><th>Titular</th></tr></thead>
    <tbody>
    {% for host, titular in defensivos %}<tr><td class="mono">{{ host }}</td><td>{{ titular }}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
{% endblock %}
