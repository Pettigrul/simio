{% extends "base.html.j2" %}
{% block cabeca %}
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src 'self' file: data:; style-src 'unsafe-inline'">
<meta name="referrer" content="no-referrer">
{% endblock %}
{% block titulo %}Dossiê · {{ c.hostname }} · {{ c.id }}{% endblock %}
{% block h1 %}Dossiê · {{ c.hostname }}{% endblock %}
{% block subtitulo %}Campanha {{ c.id_campanha }} · {{ c.id }} · gerado em {{ gerado_em }}{% endblock %}
{% block estilo %}
  .refs a { margin-right:6px; white-space:nowrap; display:inline-block; }
  td.refs { word-break:normal; width:170px; }
  .capturas img { max-height:760px; object-fit:cover; object-position:top; }
  @media print { .capturas img { max-height:420px; } }
  blockquote { margin:6px 0; padding:8px 12px; background:var(--bg); border-left:3px solid var(--line); border-radius:4px; }
  .achado { border-top:1px solid var(--line); padding-top:10px; margin-top:12px; }
  .achado:first-of-type { border-top:0; padding-top:0; margin-top:0; }
{% endblock %}
{% block conteudo %}
  {% set principal = capturas[0] if capturas else None %}
  <div class="card {{ f.classificacao|tom if f else '' }}{% if not principal %} sem-captura{% endif %}">
    {% if principal %}
    <div><a href="{{ principal.src }}"><img class="shot" src="{{ principal.src }}" alt="{{ principal.rotulo }}"></a></div>
    {% endif %}
    <div>
      {% if f %}
      <span class="pill {{ f.classificacao|tom }}">{{ f.classificacao|rotulo }}</span><span class="pill {{ f.prioridade|tom }}">Prioridade {{ f.prioridade|rotulo|lower }}</span><span class="pill cat">{{ f.caso|rotulo }}</span>{% if f.identidade_visual_antiga %}<span class="pill alto">Logo antiga</span>{% endif %}{% if f.dados_sensiveis_solicitados %}<span class="pill crit">Pede {{ f.dados_sensiveis_solicitados|join(", ") }}</span>{% endif %}
      {% else %}
      <span class="pill">Sem decisão final</span>
      {% endif %}
      <div class="url">{{ c.url }}</div>
      <dl class="kv">
        {% if f %}
        <dt>Responsável</dt><dd>{{ f.classe_identidade|rotulo }}{% if idn and idn.nome_exibicao %} · {{ idn.nome_exibicao }}{% endif %}</dd>
        {% if rv %}<dt>Revisão crítica</dt><dd>{{ rv.decisao|rotulo }}</dd>{% endif %}
        <dt>Revisão humana</dt><dd>{{ f.status_revisao_humana|rotulo }}</dd>
        <dt>Logo antiga</dt><dd>{% if f.identidade_visual_antiga %}sim, logotipo descontinuado ({{ f.fonte_identidade_visual_antiga }}){% else %}não encontrada{% endif %}</dd>
        <dt>Dados pedidos</dt><dd>{% if f.dados_sensiveis_solicitados %}{{ f.dados_sensiveis_solicitados|join(", ") }}: possível coleta de credenciais{% else %}nenhum campo de senha, cartão ou token{% endif %}</dd>
        {% else %}
        <dt>Andamento</dt><dd>{{ c.status|rotulo }}{% if c.ultimo_erro %} · {{ c.ultimo_erro }}{% endif %}</dd>
        {% endif %}
        {% if ev %}<dt>Coletada em</dt><dd>{{ ev.coletada_em|data_br }} · {{ ev.status|rotulo }}{% if ev.status_http %} (HTTP {{ ev.status_http }}){% endif %}</dd>{% endif %}
      </dl>
    </div>
  </div>
  <div class="nota">Conteúdo de terceiros aparece como texto, e os links da página não são clicáveis. Confira as conclusões nas capturas e no catálogo de evidências; cada arquivo da coleta tem hash SHA-256. Este dossiê apoia a auditoria e não é conclusão regulatória.</div>

  {% if f %}
  <h2>Decisão</h2>
  <div class="bloco">
    <div class="texto">{{ f.justificativa }}</div>
    <dl class="kv" style="margin-top:10px">
      <dt>Confiança da atribuição</dt><dd>{{ f.confianca_atribuicao|rotulo }}</dd>
      <dt>Confiança da extração</dt><dd>{{ f.confianca_extracao|rotulo }}</dd>
      <dt>Suficiência da evidência</dt><dd>{{ f.suficiencia_evidencia|rotulo }}</dd>
      {% if f.encaminhamento %}<dt>Encaminhamento sugerido</dt><dd>{{ f.encaminhamento|join("; ") }}</dd>{% endif %}
    </dl>
    {% if f.notas_salvaguarda %}
    <h3>Regras de consistência aplicadas</h3>
    <ul>{% for n in f.notas_salvaguarda %}<li>{{ n }}</li>{% endfor %}</ul>
    {% endif %}
    {% if f.limitacoes %}
    <h3>Limitações</h3>
    <ul>{% for n in f.limitacoes %}<li>{{ n }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endif %}

  {% if di %}
  <h2>Registro e hospedagem do domínio</h2>
  <div class="bloco">
    <dl class="kv">
      {% if di.plataforma %}<dt>Plataforma</dt><dd>{{ di.plataforma }}: o responsável pela página só é identificável pela plataforma (denúncia de abuso ou ordem judicial)</dd>{% endif %}
      {% if di.criado %}<dt>Domínio criado em</dt><dd>{{ di.criado }}{% if di.registrador %} · {{ di.registrador }}{% endif %}</dd>{% endif %}
      {% if di.titular %}<dt>Titular</dt><dd>{{ di.titular }}</dd>{% endif %}
      <dt>Resolve hoje</dt><dd>{{ di.resolve }}{% if di.hospedagem %} · hospedagem: {{ di.hospedagem }}{% endif %}</dd>
      {% if di.ns %}<dt>DNS (NS / MX)</dt><dd>{{ di.ns }}{% if di.mx %} / {{ di.mx }}{% endif %}</dd>{% endif %}
      {% if di.abuso %}<dt>Contatos de abuso</dt><dd>{{ di.abuso }}</dd>{% endif %}
      {% if di.notas %}<dt>Observações</dt><dd>{{ di.notas }}</dd>{% endif %}
    </dl>
  </div>
  {% endif %}

  <h2>Capturas de tela</h2>
  <div class="bloco">
    {% if capturas %}
    <div class="capturas">
    {% for s in capturas %}
      <figure>
        <a href="{{ s.src }}"><img src="{{ s.src }}" alt="{{ s.rotulo }}"></a>
        <figcaption>{{ s.rotulo }} · clique para ver em tamanho real<br><span class="mono">sha256 {{ s.sha }}</span></figcaption>
      </figure>
    {% endfor %}
    </div>
    {% else %}
    <p class="muted">Nenhuma captura disponível.</p>
    {% endif %}
  </div>

  {% if b and b.correspondencias_visuais %}
  <h2>Logo antiga: comparação de imagem</h2>
  <div class="bloco">
    <p class="muted">Regiões das capturas comparadas com a referência da logo descontinuada (B vermelho sobre V azul), sem uso de modelo.</p>
    <div class="rolagem">
    <table>
      <thead><tr><th>Captura</th><th>Posição (x, y)</th><th>Tamanho</th><th>Similaridade</th><th>Imagem na página</th></tr></thead>
      <tbody>
      {% for m in b.correspondencias_visuais %}
        <tr><td>{{ m.ref_captura }}</td><td>{{ m.bbox[0] }}, {{ m.bbox[1] }}</td><td>{{ m.bbox[2] }}×{{ m.bbox[3] }} px</td><td>{{ '%.2f'|format(m.pontuacao) }}</td><td class="mono">{{ m.src_imagem or '—' }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
  {% endif %}

  {% if b %}
  <h2>Análise de marca <span class="muted peq" style="font-weight:normal">{{ b.analisador }}{% if b.versao_prompt %}, {{ b.versao_prompt }}{% endif %}</span></h2>
  <div class="bloco">
    {% if b.possivel_injecao_prompt %}<div class="nota alerta"><b>Atenção:</b> a página contém texto com instruções dirigidas a modelos de IA (possível prompt injection).</div>{% endif %}
    <div class="texto">{{ b.resumo_raciocinio }}</div>
    {% if b.dimensoes %}
    <h3>Dimensões avaliadas</h3>
    <div class="rolagem">
    <table>
      <thead><tr><th>Dimensão</th><th>Sinal</th><th>O que foi visto</th><th>Evidências</th></tr></thead>
      <tbody>
      {% for d in b.dimensoes %}
      <tr><td>{{ d.dimensao|rotulo }}</td><td><span class="pill {{ d.sinal|tom }}">{{ d.sinal|rotulo }}</span></td><td>{{ d.constatacao }}</td><td class="mono refs">{% for r in d.refs_evidencia %}<a href="#{{ r }}">{{ r }}</a> {% endfor %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    <h3>Indícios de confusão</h3>
    <ul>{% for ind in b.indicadores_confusao_marca %}<li><span class="pill">{{ ind.forca|rotulo }}</span>{{ ind.dimensao|rotulo }}: {{ ind.descricao }} <span class="mono refs">{% for r in ind.refs_evidencia %}<a href="#{{ r }}">{{ r }}</a> {% endfor %}</span></li>{% else %}<li class="muted">nenhum</li>{% endfor %}</ul>
    <h3>Indícios de relação legítima</h3>
    <ul>{% for ind in b.indicadores_relacao_legitima %}<li><span class="pill">{{ ind.forca|rotulo }}</span>{{ ind.dimensao|rotulo }}: {{ ind.descricao }} <span class="mono refs">{% for r in ind.refs_evidencia %}<a href="#{{ r }}">{{ r }}</a> {% endfor %}</span></li>{% else %}<li class="muted">nenhum</li>{% endfor %}</ul>
    {% if b.fatos_observados %}
    <h3>Fatos observados</h3>
    <ul>{% for x in b.fatos_observados %}<li>{{ x }}</li>{% endfor %}</ul>
    {% endif %}
    {% if b.incertezas %}
    <h3>Incertezas</h3>
    <ul>{% for x in b.incertezas %}<li>{{ x }}</li>{% endfor %}</ul>
    {% endif %}
    {% if b.referencias_descartadas %}<p class="muted peq">Referências citadas pelo modelo que não existem no catálogo (descartadas): {{ b.referencias_descartadas|join(', ') }}</p>{% endif %}
  </div>
  {% endif %}

  {% if idn %}
  <h2>Responsável pela página</h2>
  <div class="bloco">
    <dl class="kv">
      <dt>Categoria</dt><dd>{{ idn.classificacao|rotulo }}</dd>
      <dt>Entidade</dt><dd>{{ idn.nome_exibicao or '—' }} <span class="mono muted">{{ idn.chave_entidade }}</span></dd>
      <dt>Confiança</dt><dd>{{ idn.confianca_atribuicao|rotulo }}</dd>
      <dt>Cadastro de correspondentes</dt><dd>{% if idn.correspondencia_cadastro %}{{ idn.correspondencia_cadastro.fonte }} (por {{ idn.correspondencia_cadastro.casado_por|rotulo }}){% else %}sem correspondência{% endif %}</dd>
    </dl>
    {% if idn.fundamentacao %}<div class="texto" style="margin-top:10px">{{ idn.fundamentacao }}</div>{% endif %}
    {% if idn.fatos %}
    <h3>Fatos observados</h3>
    <div class="rolagem">
    <table>
      <thead><tr><th>Tipo</th><th>Valor</th><th>Evidência</th><th>Contexto</th></tr></thead>
      <tbody>
      {% for x in idn.fatos %}
      <tr><td>{{ x.tipo|rotulo }}</td><td>{{ x.valor }}{% if x.valido == false %} <b class="txt-alto">(dígito verificador inválido)</b>{% endif %}</td><td class="mono">{% if x.ref_evidencia %}<a href="#{{ x.ref_evidencia }}">{{ x.ref_evidencia }}</a>{% endif %}</td><td>{{ x.contexto or '' }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    {% if idn.inferencias %}
    <h3>Inferências (não são fatos)</h3>
    <ul>{% for x in idn.inferencias %}<li>{{ x }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endif %}

  {% if comp %}
  <h2>Conformidade (hipóteses)</h2>
  <div class="bloco">
    <p class="muted">{{ comp.ressalva }}</p>
    {% for fd in comp.achados %}
    <div class="achado">
      <span class="pill {{ fd.status|tom }}">{{ fd.status|rotulo }}</span><b>{{ fd.citacao }}</b> <span class="muted peq">· {{ fd.fonte_requisito|rotulo }}</span>
      <blockquote>{{ fd.texto_requisito }}</blockquote>
      {% if fd.hipotese %}<p><b>Hipótese:</b> {{ fd.hipotese }}</p>{% endif %}
      <p><b>Evidências:</b> <span class="mono refs">{% for r in fd.evidencias_observadas %}<a href="#{{ r }}">{{ r }}</a> {% else %}—{% endfor %}</span></p>
      {% if fd.informacoes_faltantes %}<p><b>Falta saber:</b></p><ul>{% for m in fd.informacoes_faltantes %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
    {% for n in comp.notas_fora_escopo %}<div class="nota" style="margin:10px 0 0">{{ n }}</div>{% endfor %}
    {% if comp.controles_relacionados %}<h3>Controles da contratante relacionados</h3><ul>{% for n in comp.controles_relacionados %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
    {% if comp.limitacoes %}<p class="muted peq">Limitações: {{ comp.limitacoes|join('; ') }}</p>{% endif %}
  </div>
  {% endif %}

  {% if rv %}
  <h2>Revisão crítica <span class="muted peq" style="font-weight:normal">{{ rv.revisor }}</span></h2>
  <div class="bloco">
    <p>Decisão: <b>{{ rv.decisao|rotulo }}</b> · classificação revisada: <span class="txt-{{ rv.classificacao_revisada|tom }}">{{ rv.classificacao_revisada|rotulo }}</span> · prioridade {{ rv.prioridade_revisada|rotulo|lower }}</p>
    <div class="texto">{{ rv.resumo_raciocinio }}</div>
    {% if rv.contestacoes %}
    <h3>Questionamentos</h3>
    <div class="rolagem">
    <table>
      <thead><tr><th>Tema</th><th>Severidade</th><th>Questionamento</th><th>Evidências</th></tr></thead>
      <tbody>
      {% for ch in rv.contestacoes %}
      <tr><td>{{ ch.topico|rotulo }}</td><td><span class="pill {{ ch.severidade|tom }}">{{ ch.severidade|rotulo }}</span></td><td>{{ ch.preocupacao }}</td><td class="mono refs">{% for r in ch.refs_evidencia %}<a href="#{{ r }}">{{ r }}</a> {% endfor %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    {% if rv.evidencias_contraditorias %}<h3>Evidências contraditórias</h3><ul>{% for x in rv.evidencias_contraditorias %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endif %}

  <h2>Catálogo de evidências</h2>
  <div class="rolagem">
  <table>
    <thead><tr><th style="width:130px">Ref.</th><th style="width:120px">Tipo</th><th style="width:120px">Onde</th><th>Conteúdo</th></tr></thead>
    <tbody>
    {% for i in catalogo %}
    <tr id="{{ i.ref }}"><td class="mono"><b>{{ i.ref }}</b></td><td>{{ i.tipo|rotulo }}</td><td>{{ i.local|rotulo }}{% if i.acima_dobra %} (acima da dobra){% endif %}</td><td>{{ i.conteudo }}</td></tr>
    {% else %}
    <tr><td colspan="4" class="muted">Sem itens: a página não foi coletada.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <h2>Como a página foi encontrada</h2>
  <div class="rolagem">
  <table>
    <thead><tr><th>Fonte</th><th>Consulta / hipótese</th><th>URL encontrada</th><th>Título / trecho</th></tr></thead>
    <tbody>
    {% for h in resultados %}
    <tr><td>{{ h.fonte }}</td><td>{{ h.consulta or '' }}{% if h.id_hipotese %}<br><span class="muted peq">{{ h.id_hipotese }}</span>{% endif %}</td><td class="mono">{{ h.url_original }}</td><td>{{ h.titulo or '' }}{% if h.trecho %}<br><span class="muted peq">{{ h.trecho }}</span>{% endif %}</td></tr>
    {% else %}
    <tr><td colspan="4" class="muted">URL importada, sem resultado de busca.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  {% if ev %}
  <h2>Coleta e integridade</h2>
  <div class="bloco">
    <dl class="kv">
      <dt>Situação</dt><dd>{{ ev.status|rotulo }}{% if ev.status_http %} (HTTP {{ ev.status_http }}){% endif %}</dd>
      <dt>Coletada em</dt><dd>{{ ev.coletada_em|data_br }}</dd>
      <dt>IP do servidor</dt><dd>{{ ev.ip_servidor or '—' }}</dd>
      <dt>URL original</dt><dd class="mono">{{ ev.url_original }}</dd>
      <dt>URL final</dt><dd class="mono">{{ ev.url_final or '—' }}</dd>
      {% if ev.cadeia_redirecionamentos %}<dt>Redirecionamentos</dt><dd class="mono">{{ ev.cadeia_redirecionamentos|join(' → ') }}</dd>{% endif %}
      <dt>Manifesto</dt><dd class="mono">{{ ev.caminho_manifesto or '—' }}{% if ev.sha256_manifesto %}<br>sha256 {{ ev.sha256_manifesto }}{% endif %}</dd>
    </dl>
    {% if ev.erros or ev.nao_inspecionado %}
    <h3>Ocorrências e conteúdo não inspecionado</h3>
    <ul>{% for e in ev.erros %}<li>{{ e }}</li>{% endfor %}{% for e in ev.nao_inspecionado %}<li>{{ e }}</li>{% endfor %}</ul>
    {% endif %}
    <details>
      <summary>Arquivos da coleta ({{ ev.artefatos|length }})</summary>
      <div class="rolagem">
      <table>
        <thead><tr><th>Arquivo</th><th>Caminho</th><th>SHA-256</th><th>Bytes</th></tr></thead>
        <tbody>
        {% for a in ev.artefatos %}
        <tr><td>{{ a.tipo|rotulo }}</td><td class="mono">{{ a.caminho }}</td><td class="mono">{{ a.sha256 }}</td><td>{{ a.tamanho_bytes }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </details>
    {% if ev.requisicoes_bloqueadas %}
    <details>
      <summary>Requisições bloqueadas pela política de rede ({{ ev.requisicoes_bloqueadas|length }})</summary>
      <ul class="mono">{% for r in ev.requisicoes_bloqueadas[:30] %}<li>{{ r }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
  </div>
  {% endif %}

  <details class="secao">
    <summary>Histórico de estados ({{ transicoes|length }})</summary>
    <div class="rolagem">
    <table>
      <thead><tr><th>Quando</th><th>De</th><th>Para</th><th>Nota</th></tr></thead>
      <tbody>
      {% for t in transicoes %}
      <tr><td>{{ t.em|data_br }}</td><td>{{ t.status_origem|rotulo }}</td><td>{{ t.status_destino|rotulo }}</td><td>{{ t.nota or '' }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
{% endblock %}
