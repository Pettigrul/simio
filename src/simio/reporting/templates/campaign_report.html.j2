<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SIMIO — Relatório Consolidado de Campanha {{ campaign_id }}</title>
<style>
  :root {
    --bv-blue-primary: #0B5FFF;
    --bv-blue-primary-hover: #0047D4;
    --bv-blue-dark: #001A6B;
    --bv-blue-medium: #003087;
    --bv-text-primary: #272833;
    --bv-text-secondary: #6B6C7E;
    --bv-text-heading: #20262C;
    --bv-text-white: #FFFFFF;
    --bv-bg-main: #FFFFFF;
    --bv-bg-light: #F5F5F5;
    --bv-bg-blue-light: #EFF4FB;
    --bv-surface-border: #E7E7ED;
    --bv-radius-sm: 4px;
    --bv-radius-md: 8px;
    --bv-radius-lg: 12px;
    --bv-radius-pill: 999px;
    --strong: #b42318;
    --strong-bg: #fce8e6;
    --review: #b54708;
    --review-bg: #fef3d6;
    --inc: #475467;
    --inc-bg: #e7e7ed;
    --none: #067647;
    --none-bg: #e6f4ea;
  }
  * { box-sizing: border-box; }
  body {
    font-family: "BV Leve Textos", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: var(--bv-text-primary);
    background: var(--bv-bg-light);
    margin: 0;
    padding: 0 0 64px;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .header-banner {
    background: linear-gradient(135deg, var(--bv-blue-dark) 0%, var(--bv-blue-medium) 60%, var(--bv-blue-primary) 100%);
    color: var(--bv-text-white);
    padding: 28px 36px;
    box-shadow: 0 4px 16px rgba(0, 26, 107, 0.15);
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .header-brand img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }
  .header-titles h1 {
    font-family: "BV Leve Titulos", "Inter", sans-serif;
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    color: var(--bv-text-white);
    letter-spacing: -0.01em;
  }
  .header-titles p {
    font-size: 13px;
    margin: 4px 0 0;
    color: #cadcff;
  }
  .header-meta {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
  }
  .meta-tag {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 5px 14px;
    border-radius: var(--bv-radius-pill);
    font-size: 12px;
    color: var(--bv-text-white);
    display: inline-block;
  }
  .exec-date {
    font-size: 12px;
    color: #e0edff;
    font-weight: 500;
  }
  .container {
    max-width: 1200px;
    margin: 28px auto 0;
    padding: 0 20px;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .metric-card {
    background: var(--bv-bg-main);
    border: 1px solid var(--bv-surface-border);
    border-radius: var(--bv-radius-lg);
    padding: 18px 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }
  .metric-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--bv-blue-primary);
  }
  .metric-card.strong::before { background: var(--strong); }
  .metric-card.review::before { background: var(--review); }
  .metric-card.inc::before { background: var(--inc); }
  .metric-card.none::before { background: var(--none); }
  .metric-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--bv-text-secondary);
    margin-bottom: 6px;
  }
  .metric-value {
    font-family: "BV Leve Titulos", "Inter", sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: var(--bv-text-heading);
    line-height: 1.1;
  }
  .metric-desc {
    font-size: 11px;
    color: var(--bv-text-secondary);
    margin-top: 4px;
  }
  .card {
    background: var(--bv-bg-main);
    border: 1px solid var(--bv-surface-border);
    border-radius: var(--bv-radius-lg);
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    page-break-inside: avoid;
  }
  h2 {
    font-family: "BV Leve Titulos", "Inter", sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--bv-blue-dark);
    border-bottom: 2px solid var(--bv-bg-blue-light);
    padding-bottom: 10px;
    margin: 0 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    border-radius: var(--bv-radius-md);
    overflow: hidden;
    font-size: 12px;
  }
  th, td {
    border: 1px solid var(--bv-surface-border);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }
  th {
    background: var(--bv-bg-blue-light);
    color: var(--bv-blue-dark);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  td { word-break: break-word; }
  tr:nth-child(even) td {
    background-color: #fafbfc;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--bv-radius-pill);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .STRONG_INDICATION { background: var(--strong-bg); color: var(--strong); border: 1px solid var(--strong); }
  .REVIEW_REQUIRED { background: var(--review-bg); color: var(--review); border: 1px solid var(--review); }
  .INCONCLUSIVE { background: var(--inc-bg); color: var(--inc); border: 1px solid var(--inc); }
  .NO_INDICATION { background: var(--none-bg); color: var(--none); border: 1px solid var(--none); }
  .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--bv-radius-pill);
    font-size: 11px;
    font-weight: 500;
    background: #edf2f7;
    color: #4a5568;
  }
  .pill.priority {
    background: #fee2e2;
    color: #991b1b;
    font-weight: 600;
  }
  .mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; }
  .link { color: var(--bv-blue-primary); text-decoration: none; font-weight: 500; }
  .link:hover { text-decoration: underline; color: var(--bv-blue-primary-hover); }
  .audit-box {
    background: var(--bv-bg-blue-light);
    border-left: 4px solid var(--bv-blue-primary);
    padding: 14px 18px;
    border-radius: 0 var(--bv-radius-md) var(--bv-radius-md) 0;
    margin: 16px 0;
    font-size: 12px;
  }
  .audit-box b { color: var(--bv-blue-dark); }
  .footer-note {
    text-align: center;
    font-size: 11px;
    color: var(--bv-text-secondary);
    margin-top: 36px;
    padding-top: 16px;
    border-top: 1px solid var(--bv-surface-border);
  }
  @media print {
    body { background: #FFFFFF; padding: 0; }
    .container { max-width: 100%; margin: 0; padding: 12px; }
    .header-banner { padding: 16px 20px; box-shadow: none; }
    .card { box-shadow: none; border: 1px solid #ddd; margin-bottom: 16px; padding: 16px; }
    @page {
      size: A4 portrait;
      margin: 10mm;
    }
  }
</style>
</head>
<body>

<header class="header-banner">
  <div class="header-inner">
    <div class="header-brand">
      <img src="{{ bv_logo_white_uri }}" alt="Banco BV">
      <div class="header-titles">
        <h1>SIMIO · Relatório Executivo Consolidado</h1>
        <p>Sistema de Investigação de Marca e Identidade Online — Res. CMN 4.935/2021</p>
      </div>
    </div>
    <div class="header-meta">
      <div class="meta-tag">Campanha: <span class="mono">{{ campaign_id }}</span> · Marca: {{ brand_id|upper }}</div>
      <div class="exec-date">📅 Data de Execução: <strong>{{ executed_at }}</strong></div>
    </div>
  </div>
</header>

<main class="container">
  <section class="metrics-grid">
    <div class="metric-card">
      <div class="metric-title">Total de Candidatos</div>
      <div class="metric-value">{{ total_candidates }}</div>
      <div class="metric-desc">Alvos coletados e analisados</div>
    </div>
    <div class="metric-card strong">
      <div class="metric-title">Forte Indício</div>
      <div class="metric-value" style="color: var(--strong);">{{ counts.STRONG_INDICATION or 0 }}</div>
      <div class="metric-desc">Possível confusão grave</div>
    </div>
    <div class="metric-card review">
      <div class="metric-title">Requer Análise</div>
      <div class="metric-value" style="color: var(--review);">{{ counts.REVIEW_REQUIRED or 0 }}</div>
      <div class="metric-desc">Revisão pericial humana</div>
    </div>
    <div class="metric-card inc">
      <div class="metric-title">Inconclusivos</div>
      <div class="metric-value" style="color: var(--inc);">{{ counts.INCONCLUSIVE or 0 }}</div>
      <div class="metric-desc">Falha de coleta ou bloqueio</div>
    </div>
    <div class="metric-card none">
      <div class="metric-title">Sem Indício</div>
      <div class="metric-value" style="color: var(--none);">{{ counts.NO_INDICATION or 0 }}</div>
      <div class="metric-desc">Sem indício observado</div>
    </div>
    <div class="metric-card">
      <div class="metric-title">Revisão Humana Pendente</div>
      <div class="metric-value">{{ pending_reviews }}</div>
      <div class="metric-desc">Casos em auditoria</div>
    </div>
  </section>

  <div class="audit-box">
    <b>Aviso Legal e Metodologia Pericial:</b> Este relatório consolidado sumariza as evidências periciais coletadas
    e a auditoria automatizada de conformidade regulatória segundo os padrões do Banco BV e as diretrizes da Resolução CMN nº 4.935/2021.
    As classificações refletem o estado do material coletado e não constituem atestado definitivo de ilicitude sem prévia validação dos papéis de trabalho por analista credenciado.
  </div>

  <section class="card">
    <h2>
      <span>Resultados da Campanha (Todos os Candidatos)</span>
      <span style="font-size: 12px; font-weight: normal; color: var(--bv-text-secondary);">Exibindo {{ candidates|length }} registros</span>
    </h2>
    <table>
      <thead>
        <tr>
          <th style="width: 140px;">Classificação</th>
          <th>Candidato / Domínio / URL</th>
          <th style="width: 90px;">Prioridade</th>
          <th style="width: 130px;">Identidade</th>
          <th style="width: 130px;">Cenário Marca</th>
          <th style="width: 140px;">Revisão Humana</th>
          <th style="width: 90px; text-align: center;">Dossiê</th>
        </tr>
      </thead>
      <tbody>
        {% for row in candidates %}
        <tr>
          <td>
            <span class="badge {{ row.classification }}">{{ row.classification_label }}</span>
          </td>
          <td>
            <strong>{{ row.domain }}</strong>{% if row.legacy_logo %} <span class="pill priority">LOGO ANTIGA</span>{% endif %}{% if row.sensitive_data %} <span class="pill priority">PEDE {{ row.sensitive_data|upper }}</span>{% endif %}<br>
            <span class="mono" style="color: var(--bv-text-secondary); font-size: 10px;">{{ row.url }}</span><br>
            {% if row.summary %}
            <span style="font-size: 11px; color: #4b5563;">{{ row.summary }}</span>
            {% endif %}
          </td>
          <td>
            {% if row.is_priority %}
            <span class="pill priority">PRIORITÁRIO</span>
            {% else %}
            <span class="pill">NORMAL</span>
            {% endif %}
          </td>
          <td>
            <span style="font-weight: 500;">{{ row.entity_type }}</span><br>
            {% if row.entity_name %}
            <span style="font-size: 11px; color: var(--bv-text-secondary);">{{ row.entity_name }}</span>
            {% endif %}
          </td>
          <td>
            <span style="font-size: 11px;">{{ row.brand_scenario or '—' }}</span>
          </td>
          <td>
            <span class="pill">{{ row.review_status }}</span>
          </td>
          <td style="text-align: center;">
            {% if row.dossier_rel %}
            <a class="link" href="{{ row.dossier_rel }}" target="_blank">Abrir</a>
            {% else %}
            <span class="muted">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Informações da Execução e Parâmetros</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
      <div style="background: var(--bv-bg-blue-light); padding: 12px 16px; border-radius: var(--bv-radius-md);">
        <strong style="color: var(--bv-blue-dark); display: block; margin-bottom: 4px;">Campanha</strong>
        <span class="mono">{{ campaign_id }}</span> (Status: {{ campaign_status }})
      </div>
      <div style="background: var(--bv-bg-blue-light); padding: 12px 16px; border-radius: var(--bv-radius-md);">
        <strong style="color: var(--bv-blue-dark); display: block; margin-bottom: 4px;">Data/Hora da Execução</strong>
        <span>{{ executed_at }}</span>
      </div>
      <div style="background: var(--bv-bg-blue-light); padding: 12px 16px; border-radius: var(--bv-radius-md);">
        <strong style="color: var(--bv-blue-dark); display: block; margin-bottom: 4px;">Fontes Utilizadas</strong>
        <span>{{ sources_used|join(', ') if sources_used else 'Importação direta' }}</span>
      </div>
      <div style="background: var(--bv-bg-blue-light); padding: 12px 16px; border-radius: var(--bv-radius-md);">
        <strong style="color: var(--bv-blue-dark); display: block; margin-bottom: 4px;">Consumo de IA</strong>
        <span>{{ llm_requests }} requisições / {{ llm_tokens }} tokens</span>
      </div>
    </div>
  </section>

  <div class="footer-note">
    Documento gerado automaticamente por <strong>SIMIO</strong> · Sistema de Investigação de Marca e Identidade Online<br>
    Identidade Visual conforme Design System Banco BV · {{ executed_at }}
  </div>
</main>

</body>
</html>
